# Copy this file to .env.local and fill in your own values. Never commit .env.local.
# Step-by-step instructions for each value are in SETUP_STEPS.md.

# Supabase: Project Settings -> API (Data API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe TEST mode only (keys start with sk_test_ / whsec_)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: platform fee as a percent of each registration fee, for example 5. Leave empty for none.
STRIPE_PLATFORM_FEE_PERCENT=

# Public base URL of the app, no trailing slash. Locally: http://localhost:3000
NEXT_PUBLIC_APP_URL=
