# Copy this file to .env.local and fill in your own values. Never commit .env.local.
# Step-by-step instructions for each value are in SETUP_STEPS.md.

# --- Required --------------------------------------------------------------------------------

# Supabase. Without these the browser sandbox (/sandbox) still works; accounts and shared
# tournaments do not. Check your values at /setup once the app is running.
# Project Settings -> Data API -> Project URL. Only the address, like https://abcdefghijklmnop.supabase.co
# (not the supabase.com dashboard link, and nothing after .supabase.co).
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings -> API Keys: the anon / publishable key (safe in the browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings -> API Keys: the service_role / secret key. Server only. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of the app, no trailing slash. Locally: http://localhost:3000. Live: https://yourdomain.click
NEXT_PUBLIC_APP_URL=

# Protects the daily sandbox cleanup (/api/cron/cleanup). A long random string, at least 16
# characters. Vercel Cron sends it automatically when it is set in the Vercel project.
CRON_SECRET=

# --- Payments (optional) ---------------------------------------------------------------------

# Leave empty (or false) to run without payments: registration is free and confirmed at once,
# no Stripe keys are needed and Stripe is never called. Set to true to charge registration fees.
PAYMENTS_ENABLED=

# Only needed when PAYMENTS_ENABLED=true. Stripe TEST mode only (keys start with sk_test_ / whsec_).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: platform fee as a percent of each registration fee, for example 5. Leave empty for none.
STRIPE_PLATFORM_FEE_PERCENT=
